<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Atlas PP Doc"
    Width="560" Height="720" MinWidth="480" MinHeight="560"
    WindowStartupLocation="CenterScreen"
    Background="#F4F5F5"
    FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C7C7C7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFEFEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#006F8F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#006F8F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00596F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6B6B68" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E2E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <Border Background="#006F8F" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#7FD4C4" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Atlas PP Doc" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Solution zip" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ZipPathBox" Grid.Column="0" Margin="0,0,8,0" />
                        <Button x:Name="BrowseZipButton" Grid.Column="1" Content="Browse..." />
                    </Grid>

                    <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderBox" Grid.Column="0" Margin="0,0,8,0" />
                        <Button x:Name="ChooseOutputButton" Grid.Column="1" Content="Choose..." />
                    </Grid>

                    <CheckBox x:Name="AutoChainCheckBox" Content="Also run SharePoint enrichment, then build the custom view" FontSize="13" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RunPipelineButton" Grid.Column="0" Content="Run pipeline" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="RunSpButton" Grid.Column="2" Content="Run SharePoint enrichment" IsEnabled="False" />
                    </Grid>
                    <Button x:Name="RunShellButton" Content="Build custom view" IsEnabled="False" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="1. PowerDocu documentation" FontSize="13" VerticalAlignment="Center" />
                        <Border x:Name="Step1BadgeBorder" Grid.Column="1" CornerRadius="10" Padding="10,3" Background="#EDEDEC">
                            <TextBlock x:Name="Step1BadgeText" Text="Pending" FontSize="11" FontWeight="SemiBold" Foreground="#6B6B68" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="2. SharePoint enrichment" FontSize="13" VerticalAlignment="Center" />
                        <Border x:Name="Step2BadgeBorder" Grid.Column="1" CornerRadius="10" Padding="10,3" Background="#EDEDEC">
                            <TextBlock x:Name="Step2BadgeText" Text="Pending" FontSize="11" FontWeight="SemiBold" Foreground="#6B6B68" />
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="3. Custom view (reshell)" FontSize="13" VerticalAlignment="Center" />
                        <Border x:Name="Step3BadgeBorder" Grid.Column="1" CornerRadius="10" Padding="10,3" Background="#EDEDEC">
                            <TextBlock x:Name="Step3BadgeText" Text="Pending" FontSize="11" FontWeight="SemiBold" Foreground="#6B6B68" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Live log (this computer only)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LiveLogBox" Height="180" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11.5" Background="#1E1E1E" Foreground="#D8D8D8"
                             BorderThickness="0" Padding="10" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenOutputButton" Grid.Column="0" Content="Open output folder" IsEnabled="False" />
                    <Button x:Name="CopySummaryButton" Grid.Column="2" Content="Copy shareable summary" IsEnabled="False" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
